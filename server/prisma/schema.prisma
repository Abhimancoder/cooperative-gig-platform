generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?  @unique
  password    String?
  role        String   @default("CUSTOMER")
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  avatar      String?
  fcmToken    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider         Provider?
  customerBookings Booking[]      @relation("CustomerBookings")
  reviews          Review[]       @relation("CustomerReviews")
  votes            Vote[]
  notifications    Notification[]
}

model Provider {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String?
  skills              String   @default("[]")
  experience          Int      @default(0)
  kycStatus           String   @default("NOT_SUBMITTED")
  kycDocumentUrl      String?
  isApproved          Boolean  @default(false)
  cooperativeMember   Boolean  @default(false)
  rating              Float    @default(0)
  totalJobs           Int      @default(0)
  totalEarnings       Float    @default(0)
  welfareContribution Float    @default(0)
  latitude            Float?
  longitude           Float?
  city                String?
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookings     Booking[]     @relation("ProviderBookings")
  reviews      Review[]      @relation("ProviderReviews")
  payments     Payment[]
  welfareFunds WelfareFund[]
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  basePrice   Float
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id              String    @id @default(uuid())
  customerId      String
  customer        User      @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId      String?
  provider        Provider? @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  status          String    @default("PENDING")
  scheduledAt     DateTime
  address         String
  latitude        Float?
  longitude       Float?
  notes           String?
  totalAmount     Float
  platformFee     Float
  providerEarning Float
  cancelReason    String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  review  Review?
  payment Payment?
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id])
  providerId String
  provider   Provider @relation("ProviderReviews", fields: [providerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Payment {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id])
  providerId        String
  provider          Provider @relation(fields: [providerId], references: [id])
  amount            Float
  platformFee       Float
  providerEarning   Float
  welfareFund       Float
  method            String   @default("UPI")
  status            String   @default("PENDING")
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CooperativeVote {
  id          String    @id @default(uuid())
  title       String
  description String
  options     String
  status      String    @default("ACTIVE")
  createdBy   String
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  votes Vote[]
}

model Vote {
  id              String          @id @default(uuid())
  voteId          String
  cooperativeVote CooperativeVote @relation(fields: [voteId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  selectedOption  String
  createdAt       DateTime        @default(now())

  @@unique([voteId, userId])
}

model WelfareFund {
  id          String   @id @default(uuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id])
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM")
  metadata  String?
  createdAt DateTime @default(now())
}
